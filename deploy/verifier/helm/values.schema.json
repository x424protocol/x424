{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "service",
    "config",
    "secretName",
    "resources",
    "networkPolicy",
    "podDisruptionBudget"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1,
      "description": "Must remain one while World brokered handoff sessions are process-local."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentProfile",
        "providerRequestMode",
        "worldEnvironment",
        "worldAllowLegacyProofs",
        "redisTopology",
        "trustProxyHops"
      ],
      "properties": {
        "deploymentProfile": {
          "type": "string",
          "enum": ["dev-local-0.1", "eval-redis-0.2", "prod-ha-0.2"]
        },
        "providerRequestMode": {
          "type": "string",
          "enum": ["issuer", "verifier"]
        },
        "worldEnvironment": {
          "type": "string",
          "enum": ["production", "staging"]
        },
        "worldAllowLegacyProofs": {
          "type": "string",
          "enum": ["true", "false"]
        },
        "redisTopology": {
          "type": "string",
          "const": "single-endpoint"
        },
        "trustProxyHops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "secretName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number"]
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number"]
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ingressCidrs",
        "ingressNamespaceLabels",
        "ingressPodLabels",
        "dnsCidrs",
        "worldPort",
        "worldCidrs",
        "redisPort",
        "redisCidrs"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressCidrs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ingressNamespaceLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "ingressPodLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "dnsCidrs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "worldPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "worldCidrs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "redisPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "redisCidrs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
